# Dockerfile for proma2 (verl) - Optimized for running run/run.sh
# Based on vLLM 0.11.0 with sglang and flashinfer support

FROM vllm/vllm-openai:v0.11.0

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV MAX_JOBS=32
ENV VLLM_WORKER_MULTIPROC_METHOD=spawn
ENV PIP_ROOT_USER_ACTION=ignore
ENV HF_HUB_ENABLE_HF_TRANSFER=1
ENV CUDA_HOME=/usr/local/cuda
ENV FLASHINFER_CUDA_HOME=/usr/local/cuda

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libc6-dev \
    build-essential \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Create python symlink if needed
RUN ln -sf /usr/bin/python3 /usr/bin/python || true

# Install sglang and torch-memory-saver
RUN pip install --no-cache-dir "sglang[all]==0.5.2" torch-memory-saver

# Fix numpy version first (numba needs numpy < 2.2, verl needs numpy < 2.0)
RUN pip install --no-cache-dir "numpy<2.0.0"

# Install basic packages required by verl
RUN pip install --no-cache-dir \
    "transformers[hf_xet]>=4.51.0" \
    accelerate \
    datasets \
    peft \
    hf-transfer \
    "pyarrow>=15.0.0" \
    pandas \
    "tensordict>=0.8.0,<=0.10.0,!=0.9.0" \
    torchdata \
    "ray[default]" \
    codetiming \
    hydra-core \
    pylatexenc \
    qwen-vl-utils \
    wandb \
    dill \
    pybind11 \
    liger-kernel \
    mathruler \
    pytest \
    py-spy \
    tensorboard

# Install additional required packages
RUN pip install --no-cache-dir \
    "nvidia-ml-py>=12.560.30" \
    "fastapi[standard]>=0.115.0" \
    "optree>=0.13.0" \
    "pydantic>=2.9" \
    "grpcio>=1.62.1"

# Install flashinfer
RUN pip install --no-cache-dir flashinfer-python==0.3.1

# Install flash-attn if not already installed
RUN pip install --no-cache-dir flash-attn==2.8.1 || true

# Fix opencv
RUN pip install --no-cache-dir opencv-python opencv-fixer && \
    python -c "from opencv_fixer import AutoFix; AutoFix()" || true

# Install huggingface_hub CLI
RUN pip install --no-cache-dir "huggingface_hub[cli]"

# Copy the project
COPY . /app

# Install the project in editable mode
RUN pip install --no-deps -e .

# Force numpy version again (some packages may have upgraded it)
RUN pip install --no-cache-dir --force-reinstall "numpy<2.0.0"

# Create directories for model and data
RUN mkdir -p /app/models /root/data/gsm8k

# Download the Qwen3-0.6B model
RUN huggingface-cli download Qwen/Qwen3-0.6B --local-dir /app/models/Qwen3-0.6B

# Preprocess GSM8K data
RUN python examples/data_preprocess/gsm8k.py --local_save_dir /root/data/gsm8k

# Copy and setup entrypoint script
COPY docker-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Expose Ray ports
EXPOSE 6379 8265 10001

ENTRYPOINT ["/app/entrypoint.sh"]
